---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from '../../lib/sanity';
import { POSTS_QUERY } from '../../lib/queries';
import Navbar from '../../components/react/Navbar.jsx';
import Footer from '../../components/react/Footer.jsx';

let posts = [];
try {
  posts = await sanityClient.fetch(POSTS_QUERY);
} catch (error) {
  console.error('Failed to fetch posts:', error);
}
---

<Layout title="Blog — Alvian Rahmadani">
  <Navbar client:load />
  <main class="max-w-3xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold text-gray-100 mb-8">Blog</h1>
    {posts.length === 0 ? (
      <p class="text-gray-400">No posts published yet. Check back soon!</p>
    ) : (
      <ul class="flex flex-col gap-6">
        {posts.map((post) => (
          <li key={post._id} class="border border-gray-800 rounded-lg p-6 hover:border-rose-600/50 transition-colors">
            <a href={`/blog/${post.slug.current}`} class="block">
              <h2 class="text-2xl font-semibold text-gray-100 mb-2 hover:text-rose-400">{post.title}</h2>
              {post.publishedAt && (
                <time class="text-sm text-gray-500">
                  {new Date(post.publishedAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              )}
              {post.excerpt && (
                <p class="text-gray-300 mt-3 leading-relaxed">{post.excerpt}</p>
              )}
              {post.tags && post.tags.length > 0 && (
                <div class="flex gap-2 mt-3 flex-wrap">
                  {post.tags.map((tag) => (
                    <span key={tag} class="text-xs bg-gray-800 text-gray-400 px-2 py-1 rounded">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
  <Footer />
</Layout>
